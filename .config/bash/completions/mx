#!/usr/bin/env bash

_mx () {
  local word=${COMP_WORDS[COMP_CWORD]}

  COMPREPLY=()
  [ -z "$projects" ] && return 0

  local repos
  repos=$(find "$projects" -mindepth 3 -maxdepth 3 -type d -name .git -prune 2>/dev/null)

  local candidates
  candidates=$(
    printf '%s\n' "$repos" | perl -pe "s|^\Q$projects\E/||; s|/\.git$||"
    printf '%s\n' "$repos" | perl -pe 's|/\.git$||; s|.*/||'
  )
  COMPREPLY+=( $(compgen -W "$candidates" -- "$word") )
}

complete -F _mx mx
